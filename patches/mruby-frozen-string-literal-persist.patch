+MRB_API mrb_value
+mrb_frozen_literal(mrb_state *mrb, const char *p, mrb_int len)
+{
+  mrb_value key, val;
+
+  if (!mrb_hash_p(mrb->frozen_literals)) {
+    mrb->frozen_literals = mrb_hash_new(mrb);
