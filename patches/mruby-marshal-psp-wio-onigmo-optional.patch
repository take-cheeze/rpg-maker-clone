diff --git a/mrbgem.rake b/mrbgem.rake
index 4cb504c..5102f7d 100644
--- a/mrbgem.rake
+++ b/mrbgem.rake
@@ -3,7 +3,13 @@ MRuby::Gem::Specification.new('mruby-marshal') do |spec|
   spec.author = 'take-cheeze'
   spec.summary = 'Marhshal module for mruby'

-  add_dependency 'mruby-onig-regexp', github: 'mattn/mruby-onig-regexp'
+  # psp/wio (build_config.rb's single_format_only) exclude mruby-onig-regexp's
+  # own top-level conf.gem call (ADR 0098 -- nothing there ever marshals or
+  # matches against a real Regexp), but this add_dependency was unconditional
+  # and pulled it right back in, defeating that trim for real. marshal.cpp's
+  # own utility constructor no longer requires the Regexp class to exist
+  # (mrb_class_defined guard) so this is safe now, not just possible.
+  add_dependency 'mruby-onig-regexp', github: 'mattn/mruby-onig-regexp' unless %w[psp wio].include?(build.name)
   add_dependency 'mruby-string-ext', core: 'mruby-string-ext'
   add_dependency 'mruby-struct', core: 'mruby-struct'
   add_dependency 'mruby-metaprog', core: 'mruby-metaprog' if Dir.exist? "#{MRUBY_ROOT}/mrbgems/mruby-metaprog"
diff --git a/src/marshal.cpp b/src/marshal.cpp
index 7949405..df8763a 100644
--- a/src/marshal.cpp
+++ b/src/marshal.cpp
@@ -56,9 +56,18 @@ namespace {
 enum { MAJOR_VERSION = 4, MINOR_VERSION = 8, };

 struct utility {
+  // Regexp is not a core class -- only mruby-onig-regexp (or another regexp
+  // gem) defines it, and psp/wio drop that gem outright (ADR 0098; nothing
+  // real ever needs it there, see that ADR's own reasoning). A hard
+  // mrb_class_get would turn every Marshal.dump/load on those targets into
+  // an immediate NameError, so this looks before it leaps: nullptr on a
+  // build with no Regexp class at all, which the one real use site below
+  // (a `cls == regexp_class` comparison) already treats correctly as "not a
+  // Regexp" since no live object's class pointer can ever be nullptr.
   utility(mrb_state* M)
-      : M(M), regexp_class(mrb_class_get(M, "Regexp"))
-      , symbols(mrb_ary_new(M)), objects(mrb_ary_new(M)) {}
+      : M(M),
+        regexp_class(mrb_class_defined(M, "Regexp") ? mrb_class_get(M, "Regexp") : nullptr),
+        symbols(mrb_ary_new(M)), objects(mrb_ary_new(M)) {}
   mrb_state* M;

   RClass* const regexp_class;
