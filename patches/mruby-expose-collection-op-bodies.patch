 static mrb_value
 str_concat_m(mrb_state *mrb, mrb_value self)
 {
+  if (mrb_get_argc(mrb) == 1) {
+    return mrb_str_ext_concat_impl(mrb, self, mrb_get_arg1(mrb));
+  }
   mrb_bool binary = RSTR_BINARY_P(mrb_str_ptr(self));
   return str_concat0(mrb, self, binary);
