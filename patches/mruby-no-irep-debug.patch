Adds MRB_NO_IREP_DEBUG: a build option that drops the `lv` (local variable
names) and `debug_info` (line numbers) pointers from struct mrb_irep, 8
bytes per irep on a 32-bit target. Every gem's mrblib is dumped as static
C structs (src/cdump.c), one mrb_irep per method/block, so this is flash on
a build that already compiles its Ruby without -g and strips lv.

Reads go through MRB_IREP_LV()/MRB_IREP_DEBUG_INFO(), which are NULL under
the option, so backtraces, Proc#parameters and friends degrade the same way
they already do for an irep compiled without that information. The .mrb
loader skips the DEBUG and LV sections. mruby-compiler and mruby-binding,
which write the fields, refuse to build with the option. cdump.c wraps the
two initializers in #ifndef MRB_NO_IREP_DEBUG, so a host mrbc built without
the option emits C that fits a target built with it. See docs/adr/0225.

diff --git a/include/mruby/irep.h b/include/mruby/irep.h
index 1719866..5defade 100644
--- a/include/mruby/irep.h
+++ b/include/mruby/irep.h
@@ -69,9 +69,11 @@ struct mrb_irep {
   const mrb_sym *syms;
   const struct mrb_irep *const *reps;
 
+#ifndef MRB_NO_IREP_DEBUG
   const mrb_sym *lv;
   /* debug info */
   struct mrb_irep_debug_info *debug_info;
+#endif
 
   uint32_t ilen;
   uint16_t plen, slen;
@@ -79,6 +81,23 @@ struct mrb_irep {
   uint16_t refcnt;
 };
 
+/*
+ * MRB_NO_IREP_DEBUG drops the lv and debug_info fields from every irep: no
+ * local variable names and no line numbers, two pointers less per irep.  It
+ * needs a build without mruby-compiler/mruby-binding, which write them.
+ * Read the fields through these; static initializers put
+ * MRB_IREP_DEBUG_NULL_FIELDS where the two fields go.
+ */
+#ifdef MRB_NO_IREP_DEBUG
+# define MRB_IREP_LV(irep) ((const mrb_sym*)NULL)
+# define MRB_IREP_DEBUG_INFO(irep) ((struct mrb_irep_debug_info*)NULL)
+# define MRB_IREP_DEBUG_NULL_FIELDS
+#else
+# define MRB_IREP_LV(irep) ((irep)->lv)
+# define MRB_IREP_DEBUG_INFO(irep) ((irep)->debug_info)
+# define MRB_IREP_DEBUG_NULL_FIELDS NULL, NULL,
+#endif
+
 #define MRB_ISEQ_NO_FREE 1
 #define MRB_IREP_NO_FREE 2
 #define MRB_IREP_STATIC (MRB_ISEQ_NO_FREE | MRB_IREP_NO_FREE)
