+static mrb_value*
+rdata_ivar_slot(mrb_state *mrb, struct RObject *obj, mrb_sym sym)
+{
+  if (obj->tt != MRB_TT_CDATA) return NULL;
+  struct RData *data = (struct RData*)obj;
+  if (!data->type || !data->type->ivars || !data->data) return NULL;
+  mrb_int len;
+  const char *name = mrb_sym_name_len(mrb, sym, &len);
+  for (size_t i = 0; i < data->type->ivar_count; ++i) {
+    const struct mrb_data_ivar *ivar = &data->type->ivars[i];
+    if ((mrb_int)strlen(ivar->name) == len && memcmp(ivar->name, name, (size_t)len) == 0) {
+      return (mrb_value*)((char*)data->data + ivar->offset);
+    }
+  }
+  return NULL;
+}
