+  /** Optional compiler-managed instance-variable slot descriptor. */
+  const struct mrb_data_ivar *ivars;
+  size_t ivar_count;
+  size_t ivar_data_size;
@@ -29,0 +35,6 @@ typedef struct mrb_data_type {
+/** A GC-visible Ruby instance variable stored in an RData payload. */
+struct mrb_data_ivar {
+  const char *name;
+  size_t offset;
+};
+
