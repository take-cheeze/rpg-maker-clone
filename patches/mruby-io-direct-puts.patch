diff --git a/mrbgems/mruby-io/include/mruby/io.h b/mrbgems/mruby-io/include/mruby/io.h
index e76241ba6..b53430b9e 100644
--- a/mrbgems/mruby-io/include/mruby/io.h
+++ b/mrbgems/mruby-io/include/mruby/io.h
@@ -72,0 +73,5 @@ int mrb_io_fileno(mrb_state *mrb, mrb_value io);
+/* Call the core IO#puts body without a VM argument frame when method lookup
+ * still resolves to that body. Returns FALSE when Ruby overrides it. */
+MRB_API mrb_bool mrb_io_puts_direct(mrb_state *mrb, mrb_value io, mrb_int argc,
+                                    const mrb_value *argv, mrb_value *result);
+
diff --git a/mrbgems/mruby-io/src/io.c b/mrbgems/mruby-io/src/io.c
index 58b3094a2..705fe9e60 100644
--- a/mrbgems/mruby-io/src/io.c
+++ b/mrbgems/mruby-io/src/io.c
@@ -11,0 +12 @@
+#include <mruby/proc.h>
@@ -1020 +1021 @@ static mrb_value
-io_puts(mrb_state *mrb, mrb_value io)
+io_puts_argv(mrb_state *mrb, mrb_value io, mrb_int argc, const mrb_value *argv)
@@ -1028,4 +1028,0 @@ io_puts(mrb_state *mrb, mrb_value io)
-  mrb_value *argv;
-  mrb_int argc;
-  mrb_get_args(mrb, "*", &argv, &argc);
-
@@ -1052,0 +1050,23 @@ io_puts(mrb_state *mrb, mrb_value io)
+static mrb_value
+io_puts(mrb_state *mrb, mrb_value io)
+{
+  mrb_value *argv;
+  mrb_int argc;
+  mrb_get_args(mrb, "*", &argv, &argc);
+  return io_puts_argv(mrb, io, argc, argv);
+}
+
+mrb_bool
+mrb_io_puts_direct(mrb_state *mrb, mrb_value io, mrb_int argc,
+                  const mrb_value *argv, mrb_value *result)
+{
+  struct RClass *c = mrb_obj_class(mrb, io);
+  mrb_method_t method = mrb_method_search_vm(mrb, &c, MRB_SYM(puts));
+  if (MRB_METHOD_UNDEF_P(method) || !MRB_METHOD_CFUNC_P(method) ||
+      MRB_METHOD_CFUNC(method) != io_puts) {
+    return FALSE;
+  }
+  *result = io_puts_argv(mrb, io, argc, argv);
+  return TRUE;
+}
+
