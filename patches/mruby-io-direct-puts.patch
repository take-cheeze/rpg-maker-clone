   int fd = io_get_write_fd(fptr);
@@ -1025,10 +1026,6 @@ io_puts(mrb_state *mrb, mrb_value io)
   /* Prepare IO for writing (handle read buffer adjustment) */
   io_prepare_write(mrb, fptr);
 
