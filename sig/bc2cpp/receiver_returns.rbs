# Types that prove the receiver of a block send (BC2CPP_BLOCK_RECV_SURVEY=1 lists the unproven ones). Each was
# checked against every return path / every writer in mruby-rpg2k/mrblib; parameters are left untyped where the
# method's own required count is all the declaration needs.
class RPG2k
  module Scene
    class Map
      # `@event_tiles_by_pos[[x, y]] || NO_BLOCKERS`: @event_tiles_by_pos is only ever `{}` (three writers),
      # its values only come from `(@event_tiles_by_pos[[x, y]] ||= []) << e` (#index_event_tile; the other
      # access deletes), and NO_BLOCKERS is `[].freeze`. Never nil. Element left untyped.
      def blockers_at: (untyped x, untyped y) -> Array
      # The one writer is `@common = Game::CommonEvent.load(@db)` (#initialize's transition block), whose return
      # paths are `list` (only CommonEventRecord.new pushed), `list` early when there is no table, and `[]` in
      # its rescue.
      @common: Array[Game::CommonEvent::CommonEventRecord]
    end
    class EquipMenu
      # `return @candidates if @candidates` (the only non-nil writer is the line below), else
      # `@candidates = real + [[0, 0]]`, an Array#+ result. Never nil.
      def candidates: () -> Array
    end
  end
end
module Game
  class Battle
    # Called only from #finished? with @enemies, which #initialize sets from its `enemies` argument; the one
    # constructor call (Scene::Battle#start) passes `troop.members.map { |e| Game::Battle.from_enemy(e) }`
    # and nothing mutates the Array afterwards. from_enemy always returns `Combatant.new(...)`.
    def enemy_active?: (Array[Game::Battle::Combatant] side) -> bool
  end
  class TextReveal
    # The one writer is `@lines = lines || []` in #initialize; both constructor calls (Scene::Map#open_message
    # and #install_choice_lines) pass `plain`, a `map { ... .join }` result, so every element is a String.
    @lines: Array[String]
  end
end
