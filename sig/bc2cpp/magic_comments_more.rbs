# Hints moved from `# bc2cpp:` comments (same effect as the comments; see the PR body).
# Class parameters are checked call-site facts since ADR 0456; the ones no caller proves (initialize is POLY, its
# callers pass ivars) are untyped here, and the ivars they fed are declared `T?` in nilable_ivars.rbs.
class Game::Actor
  def initialize: (untyped, Integer) -> untyped
  def set_charset: (String, Integer) -> untyped
end
class Game::Actors
  def initialize: (untyped) -> untyped
  def []: (Integer) -> Game::Actor
  def existing: (Integer) -> Game::Actor
end
class Game::Battle
  def initialize: (Array[Game::Battle::Combatant], Array[Game::Battle::Combatant]) -> untyped
  def apply_stat_mods: (untyped, Array, untyped) -> untyped
  def self.from_actor: (untyped) -> Game::Battle::Combatant
  def self.from_enemy: (untyped) -> Game::Battle::Combatant
end
class Game::EnemyAi
  def initialize: (untyped, untyped) -> untyped
end
class Game::Interpreter
  def initialize: (untyped) -> untyped
  def stat_targets: (untyped) -> Array[Game::Actor]
end
class Game::Map
  def initialize: (Integer, untyped) -> untyped
end
class Game::Party
  def initialize: (untyped) -> untyped
  def promote_to_leader: (untyped) -> untyped
  def skill_targets: (untyped, untyped, untyped) -> Array[Game::Actor]
end
class Game::Shop
  def initialize: (untyped, untyped, untyped, untyped, untyped) -> untyped
end
class Game::State
  def initialize: (untyped, Integer, Integer, Integer) -> untyped
  def set_parallax: (Hash) -> untyped
  def set_system_graphic: (String, untyped) -> untyped
end
class Game::Troop
  def live_members: () -> Array[Game::Enemy]
end
class LCF::Array1D
  def initialize: (untyped, Hash) -> untyped
end
