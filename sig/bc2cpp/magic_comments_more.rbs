# Hints moved from `# bc2cpp:` comments (same effect as the comments; see the PR body).
class Game::Actor
  def initialize: (LCF::Database, Integer) -> untyped
  def set_charset: (String, Integer) -> untyped
end
class Game::Actors
  def initialize: (LCF::Database) -> untyped
  # Runtime-checked (ADR 0455, DECLARED_RETURN_GUARD): an `@all` Hash read the static check cannot follow. A
  # non-positive id, the miss and the rescue arm return nil, so the declaration is `Game::Actor?`.
  %a{bc2cpp:hint}
  def []: (Integer) -> Game::Actor?
  # Runtime-checked (ADR 0455, DECLARED_RETURN_GUARD): an `@all` Hash read; a nil id or an absent actor is nil.
  %a{bc2cpp:hint}
  def existing: (Integer) -> Game::Actor?
end
class Game::Battle
  def initialize: (Array[Game::Battle::Combatant], Array[Game::Battle::Combatant]) -> untyped
  def apply_stat_mods: (untyped, Array, untyped) -> untyped
  def self.from_actor: (untyped) -> Game::Battle::Combatant
  def self.from_enemy: (untyped) -> Game::Battle::Combatant
end
class Game::EnemyAi
  def initialize: (LCF::Database, Game::State) -> untyped
end
class Game::Interpreter
  def initialize: (Game::State) -> untyped
  # Runtime-checked (ADR 0455, DECLARED_RETURN_GUARD): `party.actors` is an attr_reader read. The Array is checked;
  # the element class stays the guarded seed it was.
  %a{bc2cpp:hint}
  def stat_targets: (untyped) -> Array[Game::Actor]
end
class Game::Map
  def initialize: (Integer, LCF::MapUnit) -> untyped
end
class Game::Party
  def initialize: (LCF::Database) -> untyped
  # The body starts `return unless actor`: nil is part of its contract.
  def promote_to_leader: (Game::Actor?) -> untyped
  def skill_targets: (untyped, untyped, untyped) -> Array[Game::Actor]
end
class Game::Shop
  def initialize: (LCF::Database, Game::Party, untyped, untyped, untyped) -> untyped
end
class Game::State
  def initialize: (Game::Party, Integer, Integer, Integer) -> untyped
  def set_parallax: (Hash) -> untyped
  def set_system_graphic: (String, untyped) -> untyped
end
class Game::Troop
  def live_members: () -> Array[Game::Enemy]
end
class LCF::Array1D
  def initialize: (untyped, Hash) -> untyped
end
class RGSS::Bitmap::LoadError
  def initialize: (String, String) -> untyped
end
class RPG2k
  # Both are called only from #start_new_game with its new Game::State.
  def open_map_editor: (Game::State) -> untyped
  def open_chipset_editor: (Game::State) -> untyped
end
class RPG2k::Scene::Base
  def initialize: (RPG2k) -> untyped
end
class RPG2k::Scene::Battle
  def initialize: (RPG2k::Scene::Map, Hash, Game::Interpreter) -> untyped
end
class RPG2k::Scene::ChipsetEditor
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::DebugMenu
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::EquipMenu
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::GameOver
  # RPG2k#show_game_over passes `self`; the state may be nil (`show_game_over(state = nil)`).
  def initialize: (RPG2k, ?untyped) -> untyped
end
class RPG2k::Scene::ItemMenu
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::Map
  def initialize: (RPG2k, Game::State) -> untyped
  # #update passes @interpreter, #drive_parallel_wait its own `it` (the Parallel Process's interpreter).
  def drive_battle: (Game::Interpreter) -> untyped
  # #step_parallel's `p[:interp]`: the Game::Interpreter.new of #new_parallel, the one writer of :interp in the
  # @parallels records. No rule proves an element of an Array ivar's Hash records yet (TC1013 at #step_parallel).
  def drive_parallel_wait: (untyped, Game::Interpreter) -> untyped
  def ids_touch?: (Array, Hash) -> untyped
  def draw_vehicle_frame: (untyped, Game::Vehicle, untyped, untyped, untyped) -> untyped
  def vehicle_charset: (Game::Vehicle) -> untyped
  def vehicle_charset_index: (Game::Vehicle) -> untyped
  def pictures_signature: (Hash[untyped, Game::Picture], Integer, Integer) -> untyped
  def toned?: (Game::Picture) -> untyped
  def toned_picture_src: (Game::Picture, untyped) -> untyped
  def draw_picture: (Game::Picture, Integer, Integer) -> untyped
end
class RPG2k::Scene::MapViewer
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::MapWorld
  def initialize: (RPG2k::Scene::Map, Game::Rng) -> untyped
  def play_sound: (String, untyped, untyped, untyped) -> untyped
