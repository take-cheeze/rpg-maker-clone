  def initialize: (RPG2k, Game::State) -> untyped
  def build_commands: () -> Array[Array]
end
class RPG2k::Scene::Order
  def initialize: (RPG2k, Game::State) -> untyped
end
class RPG2k::Scene::SaveLoad
  # title.rb and scene/map.rb open the load screen with no game state (`SaveLoad.new(parent, nil, :load)`).
  def initialize: (RPG2k, Game::State?, Symbol) -> untyped
end
