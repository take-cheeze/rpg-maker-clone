# ---- native: core_proc_calls
# The Proc methods that run the proc with their arguments, read by CoreFactSigs.proc_call_names
# (codegen_block_fallback.rb PROC_CALL_NAMES). Checked against 3rd/mruby (scripts/bc2cpp/core_facts_rbs_check.rb):
#   - call/[]: src/proc.c, `mrb_define_method_raw(mrb, pc, MRB_SYM(call), m)` and `MRB_OPSYM(aref)`, both call_proc;
#   - yield/===: mrbgems/mruby-proc-ext/mrblib/proc.rb, `def yield(*args)` / `def ===(*args)` with body `call(*args)`.
# bc2cpp-native: core_proc_calls
class Proc
  def call: (*untyped args) -> untyped
  def yield: (*untyped args) -> untyped
  def []: (*untyped args) -> untyped
  def ===: (*untyped args) -> untyped
end

# ---- predicate_returns.rbs (new block for Comparable)
class Comparable
  # Every return is provably bool (predicate gate: tools/bc2cpp/predicate_returns.rb).
  def between?: (untyped, untyped) -> bool
end

# ---- predicate_returns.rbs (new block for StringIO)
class StringIO
  # Every return is provably bool (predicate gate: tools/bc2cpp/predicate_returns.rb).
  def tty?: () -> bool
end

# ---- conversion_returns.rbs
# Result classes of Integer conversions that have a direct-call entry (NativeCoreDirect::ENTRIES): the entry's C
# expression is what codegen emits, so the return follows from it. Other owners wait for their own entries.
class Integer
  # bc2cpp-native: core_results
  def to_s: (?Integer) -> String
  # bc2cpp-native: core_results
  def to_i: () -> Integer
  # bc2cpp-native: core_results
  def inspect: () -> String
end
