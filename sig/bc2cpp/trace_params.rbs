# Parameter classes read off the CRuby traces of four game families (Nepheshel, maix-hello, mtf, Killer
# Knights; scratchpad/tp). Each is untyped statically and single-class in every trace that reached it.
# Generated by scratchpad/tp/write_sig.rb (parameters and accepted return types).
# Return bounds also include independent IR source and call-result proofs (ADR 0444).
# A class parameter is a checked call-site fact (ADR 0456): the ones no caller proves (a POLY or outside-world name,
# an argument read from an ivar, an element or a block) are untyped here.
module Game
  class Actor
    def weapon_attack_multiplier: (untyped it) -> Integer
    def total_state_count: () -> Integer
    def faceset_name: () -> String
    def faceset_index: () -> Integer
    def dead?: () -> bool
    def can_act?: () -> bool
    def rpg2003?: () -> bool
    def attack_hit_rate: () -> Integer
    def max_level: () -> Integer
    def atb_gauge: () -> Integer
    def battle_commands_changed?: () -> bool
    def rename_skill?: () -> bool
    def battle_x: () -> Integer
    def battle_y: () -> Integer
    def battler_animation_id: () -> Integer
    def alive?: () -> bool
    def skill_command_name: () -> String
  end
end
module Game
  class Interpreter
    def step_cost: (Integer code) -> Integer
    def execute: (untyped cmd) -> untyped
    def start: (Array commands) -> FalseClass
    def do_call_event: (untyped cmd) -> untyped
    def do_enemy_encounter: (untyped cmd) -> untyped
    def do_conditional: (untyped cmd) -> untyped
    def eval_condition: (untyped cmd) -> untyped
    def range: (untyped cmd) -> Range[untyped]
    def apply: (Integer op, Integer cur, Integer val) -> untyped
    def operand_value: (untyped cmd) -> untyped
    def do_control_vars: (untyped cmd) -> untyped
    def do_erase_screen: (untyped cmd) -> (TrueClass | nil)
    def play_audio: (untyped kind, untyped cmd) -> untyped
    def decode_move_route: (untyped params, String string) -> Array[untyped]
    def do_move_event: (untyped cmd) -> untyped
    def set_switch: (Integer id, Integer op) -> untyped
    def do_show_message: (untyped cmd) -> TrueClass
    def do_control_switches: (untyped cmd) -> untyped
    def do_change_event_location: (untyped cmd) -> untyped
    def do_proceed_with_movement: (untyped _cmd) -> TrueClass
    def do_change_items: (untyped cmd) -> untyped
    def character_facing: (Integer ref) -> untyped
    def do_tint_screen: (untyped cmd) -> (TrueClass | nil)
    def picture_coord: (untyped cmd, untyped idx) -> untyped
    def do_show_choices: (untyped cmd) -> TrueClass
    def trans_to_opacity: (Integer top_trans) -> untyped
    def do_wait: (untyped cmd) -> TrueClass
    def do_change_face: (untyped cmd) -> (bool | nil)
    def picture_name: (untyped cmd) -> String
    def do_show_picture: (untyped cmd) -> (Game::Picture | nil)
    def do_move_picture: (untyped cmd) -> (TrueClass | nil)
    def do_flash_screen: (untyped cmd) -> (Integer | TrueClass | nil)
    def do_change_gold: (untyped cmd) -> (Integer | nil)
    def do_pan_screen: (untyped cmd) -> (TrueClass | nil)
    def do_message_options: (untyped cmd) -> untyped
    def do_fadeout_bgm: (untyped cmd) -> untyped
    def stat_targets: (untyped cmd) -> untyped
    def do_shake_screen: (untyped cmd) -> (Integer | TrueClass | nil)
    def do_flash_sprite: (untyped cmd) -> (TrueClass | nil)
    def do_show_battle_animation: (untyped cmd) -> TrueClass
    def teleport_transition: (untyped slot) -> Integer
  end
end
module Game
  class Party
    def db_enemy_group: (Integer id) -> untyped
    def item_count: (Integer id) -> Integer
    def insert_item_in_bag: (Integer id, Integer count) -> untyped
    def gain_gold: (Integer n) -> (Integer | nil)
    def any_alive?: () -> bool
    def all_dead?: () -> bool
    def rpg2003?: () -> bool
    def alternate_battle_layout?: () -> bool
    def death_handler?: () -> bool
    def death_handler_event: () -> Integer
    def gauge_battle_layout?: () -> bool
    def automatic_battle_placement?: () -> bool
  end
end
module Game
  class Picture
    def move_to: (Integer x, Integer y, Integer zoom, Integer opacity, Integer red, Integer green, Integer blue, Integer saturation, Integer frames) -> untyped
  end
end
module Game
  class Screen
    def fade_to: (untyped target, Integer style, untyped frames, untyped erase) -> (Game::Transition | nil)
    def tint_to: (Integer r, Integer g, Integer b, Integer sat, Integer frames) -> untyped
    def pan_step_for: (Integer speed) -> untyped
    def shake: (Integer power, Integer speed, Integer frames) -> untyped
  end
end
module Game
  class State
    def se_chunk: (Hash se) -> LCF::Array1D
    def show_picture: (Integer id, Hash opts) -> (Game::Picture | nil)
    def boarded?: () -> bool
    def pictures_moving?: () -> bool
  end
end
module Game
  class Switches
    def []: (Integer id) -> bool
    def []=: (Integer id, untyped v) -> bool
  end
end
module Game
  class Variables
    def []: (Integer id) -> untyped
    def []=: (Integer id, Integer v) -> untyped
  end
end
module LCF
  class Array1D
    def field?: (Symbol sym) -> bool
    def key?: (Integer idx) -> bool
    def []=: (Integer idx, untyped value) -> untyped
    def int16_values: (Integer idx) -> untyped
  end
end
module LCF
  class Array2D
    def initialize: (String s, Hash schema) -> untyped
    def []=: (Integer idx, untyped entry) -> (LCF::Array1D | String | nil)
    def same_schema?: (Hash other) -> bool
    def []: (Integer idx) -> untyped
  end
end
module LCF
  class Database
    def rpg2003?: () -> bool
  end
end
module LCF
  class EventCommand
    def initialize: (Integer code, Integer indent, String string, untyped parameters) -> untyped
    def param: (Integer i) -> untyped
  end
end
module LCF
  class File
    def []: (Symbol idx) -> untyped
    def field?: (Symbol sym) -> bool
    def build_root: (untyped io, Hash root_schema) -> untyped
    def []=: (Integer idx, untyped value) -> untyped
  end
end
