# Layout constants the DECLARED_CONSTANT_CHECK (docs/adr/0455) evaluates at every assignment: integer literals and
# other such constants combined with + - * / whose interval fits a Fixnum. Each bare name's every binding checks, so
# it joins INTEGER_CONSTANT_PROOF (inference proves literal / + - chains only). Listed: the ones method bodies read.
module RPG2k
  module Scene
    class Battle
      BATTLE_PANEL_Y: Integer
      BATTLE_STATUS_W: Integer
    end
    class ChipsetEditor
      HEADER_H: Integer
    end
    class DebugMenu
      SCREEN_SIZE: Integer
    end
    class EquipMenu
      CAND_Y: Integer
      DESC_H: Integer
      PANEL_H: Integer
      VISIBLE_ROWS: Integer
    end
    class ItemMenu
      DESC_H: Integer
      LIST_H: Integer
      VISIBLE_ROWS: Integer
    end
    class Map
      SHOP_DESC_H: Integer
    end
    class MapViewer
      HEADER_H: Integer
    end
    class Order
      LIST_H: Integer
      LIST_Y: Integer
    end
    class SaveLoad
      HEADER_H: Integer
    end
    class SkillMenu
      COL_PITCH: Integer
      DESC_H: Integer
      LIST_H: Integer
      LIST_Y: Integer
      VISIBLE_ROWS: Integer
    end
    class StatusMenu
      RIGHT_W: Integer
    end
  end
end
