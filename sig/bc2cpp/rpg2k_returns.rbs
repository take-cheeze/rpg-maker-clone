# Return hints for methods whose every return path is an Array, each checked against its body in mruby-rpg2k/mrblib.
# Left out on purpose: Scene::Battle#battle_ally_targets and Scene::SkillMenu#skills (they depend on @ui[:allies] and
# caster.skills, untyped), Game::Actor#battle_commands (its setter stores ids.dup of an untyped argument), and
# Scene::Map#blockers_at (its hash values are not typed).
module RPG2k
  module Scene
    class SkillMenu
      def teleport_targets: () -> Array
    end
    class ItemMenu
      def teleport_targets: () -> Array
    end
    class Battle
      def battle_commands: () -> Array
    end
    class Map
      def shop_lines: () -> Array
    end
  end
end
module Game
  class Actor
    def equipped_weapons: () -> Array
  end
end
