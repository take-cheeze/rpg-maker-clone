# ---- native: core_block_params
# Block parameter shapes of core Array and Hash iterators (CORE_BLOCK_ELEMENT_HINT), read by CoreBlockParamSigs
# (tools/bc2cpp/core_block_param_sigs.rb) for CodeGen#block_fallback_element_hints. A block parameter typed `Elem`
# (Array) or `V` (Hash) receives one element (value) of the receiver; `K` and `untyped` positions get no hint (no
# key facts exist). The method's own positionals give the argument counts the shape holds for: required ones must
# be passed, optional ones may be. Only the block's positional count is matched against the literal block, so a
# block whose arity differs (`each { |a, b| }` destructures an element) gets nothing.
#
# Verified against 3rd/mruby:
#   - Array#each, #sort (mrblib/array.rb), #index/#rindex (src/array.c, mrb_yield of each element);
#   - Enumerable#collect/map, #detect/find, #find_all/select, #reject, #partition, #each_with_index, #inject/reduce
#     (mrblib/enum.rb: `self.each {|*val| block.call(*val)}`, so each call gets the element itself; inject calls
#     `block.call(result, val)`, each_with_index `block.call(val.__svalue, i)`);
#   - Enumerable#count/any?/all?/none?/flat_map/group_by/min_by/max_by/sum/find_index/filter_map/each_with_object/
#     take_while/drop_while/filter (mruby-enum-ext), Array#sort_by (mruby-enum-ext, `each_with_index {|e, i|
#     block.call(e)}`);
#   - Array#find/uniq/delete_if/reject!/keep_if/select!/reverse_each (mruby-array-ext);
#   - Hash#each (mrblib/hash.rb, `block.call([keys[i], vals[i]])`, which a two-parameter block destructures),
#     #each_pair (alias), #each_value (`block.call(v)`), #each_key, #select/#reject (`block.call([k, v])`),
#     #filter (alias, mruby-hash-ext).
# A program definition of the name on the receiver's lookup chain voids the shape (block_fallback_element_hints).
# Array#each's `-> self` is a block-return declaration (BLOCK_RETURNS, docs/adr/0475), checked against mrblib/array.rb's
# body (`return to_enum(:each) unless block`, `yield self[idx]` in a loop, then `self`).
# bc2cpp-native: core_block_params
class Array[unchecked out Elem]
  def each: () { (Elem) -> void } -> self
  def reverse_each: () { (Elem) -> void } -> untyped
  def map: () { (Elem) -> untyped } -> untyped
  def collect: () { (Elem) -> untyped } -> untyped
  def flat_map: () { (Elem) -> untyped } -> untyped
  def filter_map: () { (Elem) -> untyped } -> untyped
  def select: () { (Elem) -> untyped } -> untyped
  def filter: () { (Elem) -> untyped } -> untyped
  def find_all: () { (Elem) -> untyped } -> untyped
  def reject: () { (Elem) -> untyped } -> untyped
  def select!: () { (Elem) -> untyped } -> untyped
  def reject!: () { (Elem) -> untyped } -> untyped
  def keep_if: () { (Elem) -> untyped } -> untyped
  def delete_if: () { (Elem) -> untyped } -> untyped
  def partition: () { (Elem) -> untyped } -> untyped
  def group_by: () { (Elem) -> untyped } -> untyped
  def find: (?untyped ifnone) { (Elem) -> untyped } -> untyped
  def detect: (?untyped ifnone) { (Elem) -> untyped } -> untyped
  def find_index: () { (Elem) -> untyped } -> untyped
  def index: () { (Elem) -> untyped } -> untyped
  def rindex: () { (Elem) -> untyped } -> untyped
  def any?: () { (Elem) -> untyped } -> untyped
  def all?: () { (Elem) -> untyped } -> untyped
  def none?: () { (Elem) -> untyped } -> untyped
  def count: () { (Elem) -> untyped } -> untyped
  def sum: (?untyped init) { (Elem) -> untyped } -> untyped
  def sort_by: () { (Elem) -> untyped } -> untyped
  def min_by: () { (Elem) -> untyped } -> untyped
  def max_by: () { (Elem) -> untyped } -> untyped
  def uniq: () { (Elem) -> untyped } -> untyped
  def take_while: () { (Elem) -> untyped } -> untyped
  def drop_while: () { (Elem) -> untyped } -> untyped
  def sort: () { (Elem, Elem) -> untyped } -> untyped
  def each_with_index: () { (Elem, Integer) -> void } -> untyped
  def each_with_object: (untyped memo) { (Elem, untyped) -> void } -> untyped
  def inject: (?untyped init) { (untyped, Elem) -> untyped } -> untyped
  def reduce: (?untyped init) { (untyped, Elem) -> untyped } -> untyped
end

# bc2cpp-native: core_block_params
class Hash[unchecked out K, unchecked out V]
  def each: () { (K, V) -> void } -> untyped
  def each_pair: () { (K, V) -> void } -> untyped
  def each_value: () { (V) -> void } -> untyped
  def each_key: () { (K) -> void } -> untyped
  def select: () { (K, V) -> untyped } -> untyped
  def filter: () { (K, V) -> untyped } -> untyped
  def reject: () { (K, V) -> untyped } -> untyped
end

# ---- native: core_block_returns
# Block-return declarations of methods mruby's own Ruby defines (BLOCK_RETURNS, docs/adr/0475). Each is checked
# against the method's bytecode, compiled from the build's own source (an outside Ruby file is compiled for the check):
# a plain yielder whose every yield passes the declared arguments, and whose every return path, with a block given,
# returns a yield's value (`-> T`) or self (`-> self`). Array#each's `-> self` is in core_block_params.rbs.
#
# Verified against 3rd/mruby/mrbgems/mruby-object-ext/mrblib/object.rb:
#   - Kernel#tap: `yield self; self` (BLKCALL with one argument, RETSELF);
#   - Kernel#yield_self: `return to_enum(:yield_self) unless block; block.call(self)` (the to_enum path needs no block);
#   - Kernel#then: `alias then yield_self`, unconditional in the module body.
# Left out, as not one of the two shapes: Hash#fetch and Array#fetch with a block return the stored value when the key
# is present (`V | T`), and Hash#each's block receives one [key, value] Array that core_block_params.rbs's (K, V)
# shape destructures.
# bc2cpp-native: core_block_returns
module Kernel
  def tap: () { (self) -> void } -> self
  def yield_self: [T] () { (self) -> T } -> T
  def then: [T] () { (self) -> T } -> T
end

# ---- native: core_class_tests
# The classes mruby's own natives register each class-test name on, read by CoreFactSigs.class_test_owners
# (codegen_class_narrowing.rb CLASS_TEST_NATIVE_OWNERS). CodeGen#class_test_native_owners? accepts a name only when
# every native registration the build compiles lands on one of these owners. The positional parameters are the
# registration's arity. scripts/bc2cpp/core_facts_rbs_check.rb scans 3rd/mruby's sources (the scan codegen uses,
# NativeExpressionDevirt.scan_class_registrations) and requires each name's owners and arity to be exactly these:
#   - Kernel: src/kernel.c kernel_rom_entries;
#   - NilClass#nil?: src/object.c nil_rom_entries (mrb_true);
#   - BasicObject#!: src/class.c bob_rom_entries (mrb_bob_not).
# bc2cpp-native: core_class_tests
module Kernel
  def is_a?: (Module klass) -> bool
  def kind_of?: (Module klass) -> bool
  def instance_of?: (Module klass) -> bool
  def nil?: () -> bool
end

# bc2cpp-native: core_class_tests
class NilClass
  def nil?: () -> true
end

# bc2cpp-native: core_class_tests
class BasicObject
  def !: () -> bool
end

# bc2cpp-native: core_class_tests
module Kernel
  def raise: (?untyped exception, ?String message) -> bot
  def respond_to?: (Symbol name, ?bool include_all) -> bool
  def class: () -> untyped
end

# ---- native: core_enumerators
# Kernel methods that build an Enumerator over another method of the receiver, read by CoreFactSigs.enumerator_makers
# (call_site_index.rb ENUM_SENDS, enumerator_model.rb NAMES): `to_enum(:meth, *args)` later runs `meth(*args)` on
# the receiver, so a site naming one is a caller of `meth`. Each must return Enumerator. scripts/bc2cpp/
# core_facts_rbs_check.rb checks them against mrbgems/mruby-enumerator/mrblib/enumerator.rb: `module Kernel` defines
# `def to_enum(meth=:each, *args, **kwd)` as `Enumerator.new self, meth, *args, **kwd` and `alias enum_for to_enum`.
# EnumeratorModel still proves the program's definitions are those before TO_ENUM_DIRECT trusts them.
# bc2cpp-native: core_enumerators
module Kernel
  def to_enum: (?Symbol meth, *untyped args, **untyped kwd) -> Enumerator[untyped, untyped]
  def enum_for: (?Symbol meth, *untyped args, **untyped kwd) -> Enumerator[untyped, untyped]
end

# ---- native: core_frame_readers
# Kernel methods that read the CALLING frame, read by CoreFactSigs.frame_readers (tools/bc2cpp/core_fact_sigs.rb).
# The return type says what is read: a bool answers whether the caller was passed a block
# (codegen_arg_shapes.rb BLOCK_GIVEN_NAMES), a Binding captures the caller's whole frame (FRAME_READING_NAMES).
# Any other return is rejected. scripts/bc2cpp/core_facts_rbs_check.rb checks each against 3rd/mruby:
#   - block_given?/iterator?: src/kernel.c, kernel_rom_entries `MRB_MT_ENTRY(mrb_f_block_given_p_m, ...)`, no
#     arguments, registered on Kernel only;
#   - binding: mrbgems/mruby-binding/src/binding.c, `mrb_define_private_method_id(mrb, mrb->kernel_module,
#     MRB_SYM(binding), mrb_f_binding, MRB_ARGS_NONE())`.
# bc2cpp-native: core_frame_readers
module Kernel
  def block_given?: () -> bool
  def iterator?: () -> bool
  def binding: () -> Binding
end

# ---- native: core_fresh_arrays
# Core methods that return a fresh Array whenever they return, read by NativeCoreResultSigs.fresh_array_names
# (class_layout.rb CORE_ARRAY_RETURN_METHODS). Only the method names matter there: core_array_return? still requires
# every definition of the name to be mruby core or a vetted override. Verified against 3rd/mruby:
#   - keys/values: mrb_hash_keys/mrb_hash_values (src/hash.c);
#   - compact: ary_compact (mruby-array-ext), a dup;
#   - flatten: ary_flatten -> flatten_internal, a new Array;
#   - split: String#split (src/string.c);
#   - uniq: Array#uniq (dup / __uniq) and Enumerable#uniq (hash.values).
# Not here: to_a/dup (receiver-dependent, see core_results.rbs), to_h (Hash), blockless sort_by
# (CORE_ARRAY_CHAIN_NEEDS_BLOCK) and argless first/last (CORE_ARRAY_CHAIN_NEEDS_ARG).
# bc2cpp-native: core_fresh_arrays
class Hash
  def keys: () -> Array[untyped]
  def values: () -> Array[untyped]
end

# bc2cpp-native: core_fresh_arrays
class String
  def split: (*untyped args) -> Array[String]
end

# bc2cpp-native: core_fresh_arrays
class Array
  def compact: () -> Array[untyped]
  def flatten: (?Integer depth) -> Array[untyped]
  def uniq: () -> Array[untyped]
end

