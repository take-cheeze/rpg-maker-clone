# ---- singleton_optional.rbs
# Declarations the loader could not use before ADR 0456: `def self.` returns, `T?` ivars, and class parameters that
# every caller is proven to pass (RbsParamCheck verifies each call site; an unproven one is a TC1013 error).
module Game
  class Message
    # One return path: `result`, the `ScanResult.new` (Game::Message::ScanResult, lexical) built at the end of the
    # body; nothing in the program subclasses ScanResult or defines `new`.
    def self.scan: (untyped text, untyped variables, untyped names, ?untyped start_color) -> Game::Message::ScanResult
    # `scan(...).segments`: #scan always assigns `result.segments = segs`, `segs = []` whose only pushes are
    # `Segment.new` values (`segs << seg` twice); `segments=` has no other caller.
    def self.parse: (untyped text, untyped variables, untyped names) -> Array[Game::Message::Segment]
    class ScanResult
      # nil from #initialize; the only other writers are #scan's `result.segments = segs` / `result.pauses = pauses`
      # (Arrays of Segment.new / PauseMarker.new values only). ScanResult is only constructed in #scan.
      @segments: Array[Game::Message::Segment]?
      @pauses: Array[Game::Message::PauseMarker]?
    end
  end
  class Battle
    class Combatant
      # nil from #initialize; the writers are Battle.from_enemy's `e.respond_to?(:actions) ? (e.actions || []) : []`
      # and #enemy_transform_action's `into.actions`, `e` / `into` being Game::Enemy (Troop members,
      # EnemyAi#enemy), whose one @actions writer is `[]` filled with `EnemyAction.new(a)`. Actors keep nil.
      @actions: Array[Game::EnemyAction]?
    end
  end
  class Enemy
    # One caller, Scene::Battle's transform replay: `member.reseed_rewards(Game::Enemy.new(db, foe.enemy_id))`.
    def reseed_rewards: (Game::Enemy into) -> untyped
  end
end
class RPG2k
  module Scene
    class Battle
      # One caller (#start): `battle_encounter_lines(troop, @req)`, troop = `Game::Troop.new(...)`.
      def battle_encounter_lines: (Game::Troop troop, untyped req) -> untyped
    end
  end
end

