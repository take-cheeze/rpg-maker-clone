# ---- native: core_predicates
# Built-in predicates, declared from the standard RBS core (rbs gem core/array.rbs, hash.rbs, enumerable.rbs). mruby
# defines these in Ruby (3rd/mruby/mrblib/enum.rb and mruby-enum-ext), and both forms return only true or false.
# Declarations only: the program does not define them, so rbs_signatures.rb gives them no hint and core_results.rbs
# still holds the result kinds NativeCoreResultSigs reads.
# bc2cpp-native: core_predicates
class Array
  def any?: () -> bool | (untyped) -> bool | () { (untyped) -> untyped } -> bool
end

# bc2cpp-native: core_predicates
class Hash
  def any?: () -> bool | (untyped) -> bool | () { (untyped) -> untyped } -> bool
end

# bc2cpp-native: core_predicates
module Enumerable
  def any?: () -> bool | (untyped) -> bool | () { (untyped) -> untyped } -> bool
end

# ---- native: core_proc_calls
# The Proc methods that run the proc with their arguments, read by CoreFactSigs.proc_call_names
# (codegen_block_fallback.rb PROC_CALL_NAMES). bc2cpp_cfunc_proc_call_p (bc2cpp.rb) spells the same set; scripts/
# bc2cpp/core_facts_rbs_check.rb fails when the two differ. Checked against 3rd/mruby:
#   - call/[]: src/proc.c, `mrb_define_method_raw(mrb, pc, MRB_SYM(call), m)` and `MRB_OPSYM(aref)`, both call_proc;
#   - yield/===: mrbgems/mruby-proc-ext/mrblib/proc.rb, `def yield(*args)` / `def ===(*args)` with body `call(*args)`.
# bc2cpp-native: core_proc_calls
class Proc
  def call: (*untyped args) -> untyped
  def yield: (*untyped args) -> untyped
  def []: (*untyped args) -> untyped
  def ===: (*untyped args) -> untyped
end

# ---- native: core_results
# Result classes of built-in methods, read by tools/bc2cpp/native_core_result_sigs.rb (not by rbs_signatures.rb:
# these methods are native, so the program does not define them). A return names the class a call on an exact
# receiver of that class yields. Only Array and String are accepted. Each entry still needs the closed-world pins in
# NativeClassResults.core_result_pinned? and codegen_native_results.rb before codegen trusts it.
# bc2cpp-native: core_results
class Array
  def to_a: () -> Array[untyped]
  def compact: () -> Array[untyped]
  def join: (?String sep) -> String
end

# bc2cpp-native: core_results
class String
  def bytes: () -> Array[Integer]
end

# ---- native: rgss_block_returns
# Block-return declarations of RGSS natives (BLOCK_RETURNS, docs/adr/0475). Each is checked against the C function
# every registration of the name points at (BlockReturns.native_function_why): the block is read only by
# mrb_get_args, mrb_nil_p and a yield, every yield passes the declared arguments, and every return is a yield's value.
# A call `RGSS::Profiler.section("name") { ... }` then has the class of the block's value, and the block runs under
# the caller's self.
#
# mruby-rgss/src/profiler.cxx: prof_section and prof_frame `return mrb_yield_argv(M, blk, 0, nullptr)` with profiling
# off and `return ret` (`const mrb_value ret = mrb_yield_argv(...)`) with it on; prof_stub_yield, both names in the
# builds that compile the profiler out, returns mrb_yield_argv's value too. Each answers nil without a block, which a
# literal block never takes.
# bc2cpp-native: rgss_block_returns
module RGSS
  module Profiler
    def self.section: [T] (String name) { () -> T } -> T
    def self.frame: [T] () { () -> T } -> T
  end
end

# ---- native: rgss_constructors
# Constructor overloads of the RGSS native classes, read by NativeConstructorSigs (tools/bc2cpp/native_constructor_sigs.rb)
# for OVERLOADED_CONSTRUCT (docs/adr/0468). Each overload of `initialize` is one accepted form of `Klass.new`, in RBS's
# own overload syntax, and its annotation names the direct path a call site takes for it:
#
#   %a{bc2cpp:direct <function> <arg>...}  a rgss_construct.hxx entry point taking the class pointer, then one
#        argument per <arg>: `int` / `float` convert the next positional with mrb_as_int / mrb_as_float (what
#        mrb_get_args "i" / "f" do, raising the same TypeError), `int=K` / `float=K` take K when that positional is
#        absent, a bare number is passed as it is;
#   %a{bc2cpp:compiled}  allocation plus the compiled Ruby `initialize` of the class;
#   %a{bc2cpp:else}      (with either) the form the class's own initialize takes for every argument the other
#        overloads do not match, so it is the call site's final branch and raises what the native raises.
#
# Types: `Integer | Float` is a numeric argument mrb_get_args "i" or "f" converts, `String` one "z"/"s"/"S" reads,
# `boolish` one "b" reads by truthiness only (mrb_test: any object; nil and false are false). Nothing is `untyped`.
# Every declaration is audited against the C sources (and, for Bitmap, the Ruby
# initialize that splits on `kind_of? String`) when it is loaded: a declared form the source does not accept, or an
# accepted form left undeclared, refuses the whole file (NativeConstructorSigs.audit).
# bc2cpp-native: rgss_constructors
class RGSS::Bitmap
  def initialize: %a{bc2cpp:compiled} (String filename, ?boolish transparent) -> void
                | %a{bc2cpp:direct rgss::bitmap_new_direct int int} %a{bc2cpp:else} (Integer | Float width, Integer | Float height) -> void
end

# bc2cpp-native: rgss_constructors
class RGSS::Rect
  def initialize: %a{bc2cpp:direct rgss::rect_new_direct 0 0 0 0} () -> void
                | %a{bc2cpp:direct rgss::rect_new_direct int int int int} %a{bc2cpp:else} (Integer | Float x, Integer | Float y, Integer | Float width, Integer | Float height) -> void
end

# bc2cpp-native: rgss_constructors
class RGSS::Color
  def initialize: %a{bc2cpp:direct rgss::color_new_direct float=0 float=0 float=0 float=255} %a{bc2cpp:else} (?Integer | Float red, ?Integer | Float green, ?Integer | Float blue, ?Integer | Float alpha) -> void
end

# bc2cpp-native: rgss_constructors
class RGSS::Tone
  def initialize: %a{bc2cpp:direct rgss::tone_new_direct float=0 float=0 float=0 float=0} %a{bc2cpp:else} (?Integer | Float red, ?Integer | Float green, ?Integer | Float blue, ?Integer | Float gray) -> void
end

# ---- native: rgss_results
# RGSS native result kinds, read by NativeResultFacts (native_result_facts.rb) through NativeCoreResultSigs. Each
# method names the kind a call on that exact receiver returns: Integer is mrb_fixnum_value, Float is mrb_float_value,
# RGSS::Rect is an mrb_obj_new of that constant. A method is listed only when every return path has that kind; see
# NATIVE_RESULT_FACTS for what is left out and the callee and delegation audit in native_result_facts_check.rb.
# bc2cpp-native: rgss_results
class RGSS::Bitmap
  def width: () -> Integer
  def height: () -> Integer
  def rect: () -> RGSS::Rect
  def text_size: () -> RGSS::Rect
end

# bc2cpp-native: rgss_results
class RGSS::Rect
  def x: () -> Integer
  def y: () -> Integer
  def width: () -> Integer
  def height: () -> Integer
end

# bc2cpp-native: rgss_results
class RGSS::Color
  def red: () -> Float
  def green: () -> Float
  def blue: () -> Float
  def alpha: () -> Float
end

# bc2cpp-native: rgss_results
class RGSS::Tone
  def red: () -> Float
  def green: () -> Float
  def blue: () -> Float
  def gray: () -> Float
end

