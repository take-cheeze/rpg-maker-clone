# ---- block_types.rbs
# Block parameter types of engine methods that yield (RBS_BLOCK_PARAM_HINT, read by
# CodeGen#block_fallback_rbs_param_class). Each is declared only where the yielded values are certain
# from the method body; the method's own positionals are declared too so the required count matches.
# A send reaches a declaration through an exact receiver (its own or an inherited declaration) or as an
# implicit-self call in the declaring class, provided every descendant override declares the same class.
module Game
  class Actors
    # `all.each(&blk)`: `all` maps @all's values, each built by `Actor.new(@db, id)`.
    def each: () { (Game::Actor) -> void } -> untyped
  end
  class Party
    # `@actors.each(&blk)`: every member comes from `@roster[i]` (Game::Actors#[] -> Game::Actor).
    def each: () { (Game::Actor) -> void } -> untyped
  end
  class Battle
    # `yield t` for each of `targets`, always @enemies or @allies (Array[Game::Battle::Combatant]).
    def auto_battle_best_target: (untyped targets) { (Game::Battle::Combatant) -> untyped } -> untyped
  end
end
module LCF
  class Array2D
    # `yield i, v unless v.nil?`: i is a `times` index, v is `self[i]` (an Array1D once non-nil).
    def each: () { (Integer, LCF::Array1D) -> void } -> untyped
  end
end
class RPG2k
  module Scene
    class MapViewer
      # `yield id, ev[:name], x, y`: id is an LCF::Array2D#each index.
      def each_event_position: () { (Integer, untyped, untyped, untyped) -> void } -> untyped
    end
  end
end

# ---- checked_constants.rbs
# Layout constants the DECLARED_CONSTANT_CHECK (docs/adr/0455) evaluates at every assignment: integer literals and
# other such constants combined with + - * / whose interval fits a Fixnum. Each bare name's every binding checks, so
# it joins INTEGER_CONSTANT_PROOF (inference proves literal / + - chains only). Listed: the ones method bodies read.
module RPG2k
  module Scene
    class Battle
      BATTLE_PANEL_Y: Integer
      BATTLE_STATUS_W: Integer
    end
    class ChipsetEditor
      HEADER_H: Integer
    end
    class DebugMenu
      SCREEN_SIZE: Integer
    end
    class EquipMenu
      CAND_Y: Integer
      DESC_H: Integer
      PANEL_H: Integer
      VISIBLE_ROWS: Integer
    end
    class ItemMenu
      DESC_H: Integer
      LIST_H: Integer
      VISIBLE_ROWS: Integer
    end
    class Map
      SHOP_DESC_H: Integer
    end
    class MapViewer
      HEADER_H: Integer
    end
    class Order
      LIST_H: Integer
      LIST_Y: Integer
    end
    class SaveLoad
      HEADER_H: Integer
    end
    class SkillMenu
      COL_PITCH: Integer
      DESC_H: Integer
      LIST_H: Integer
      LIST_Y: Integer
      VISIBLE_ROWS: Integer
    end
    class StatusMenu
      RIGHT_W: Integer
    end
  end
end

# ---- checked_returns.rbs
# Return types the DECLARED_RETURN_CHECK (docs/adr/0455) proves on every return path; each adds the fact the return
# proofs produce, where inference alone is silent.
module Game
  class Battle
    # Every arm is `[b]`, `[]`, `[x[i]]` or an Array#reject of @allies / @enemies (both Array on every writer).
    def enemy_skill_targets: (untyped b, untyped sk) -> Array
  end
  class State
    # `@vehicles[type]`. @vehicles is only ever stored the `{ boat: Vehicle.new(:boat), ... }` literal and is only
    # read as `@vehicles[k]` (SEALED_HASH_IVAR, ADR 0456), so this is a Vehicle, or nil for a type it lacks. The
    # callers' NIL_NARROWING (draw_vehicles' `v.placed?`) proves the non-nil arguments they pass on.
    def vehicle: (untyped type) -> Game::Vehicle?
    # One return path, `state` = `Game::State.new(party, ...)` (a missing hero/inventory record raises instead).
    # RPG2k#load_save_state passes its @db, an LCF::Database (RBS_CHECKED_PARAMS, ADR 0456).
    def self.from_lsd: (LCF::Database db, untyped save) -> Game::State
  end
end
module RPG2k
  # `Game::State.from_lsd(@db, save)`, or nil: no Save<slot>.lsd (`return nil unless File.exist?`) or an
  # unreadable one (the rescue). #continue_game returns on nil before Scene::Map.new; Scene::SaveLoad keeps nil
  # as an empty slot.
  def load_save_state: (?untyped slot) -> Game::State?
  module Scene
    # POLY: both definitions are `@mode == :target ? SCREEN_W - TARGET_W : SCREEN_W`, so both are declared; the
    # MONO-only FIXNUM_RETURN_PROOF cannot name a POLY result.
    class SkillMenu
      def left_panel_w: () -> Integer
    end
    class ItemMenu
      def left_panel_w: () -> Integer
    end
  end
end

