class RPG2k
  module Scene
    class Base
      # One writer each, in #initialize(parent). Every scene is built with RPG2k's `self` (main.rb), another scene's
      # @parent / `parent` (Scene::Base's attr_reader) or `map.parent` (Scene::Battle). RPG2k#db / #map_tree are
      # attr_readers whose one writers are `LCF::Database.new` / `LCF::MapTree.new`.
      @parent: RPG2k?
      @db: LCF::Database?
      @map_tree: LCF::MapTree?
    end
    class Map
      @state: Game::State?
    end
    class Menu
      @state: Game::State?
    end
    class SaveLoad
      @state: Game::State?
    end
    class MapViewer
      @state: Game::State?
    end
    class StatusMenu
      @state: Game::State?
    end
    class SkillMenu
      @state: Game::State?
    end
    class DebugMenu
      @state: Game::State?
    end
    class ItemMenu
      @state: Game::State?
    end
    class Order
      @state: Game::State?
    end
    class EquipMenu
      @state: Game::State?
    end
    class ChipsetEditor
      @state: Game::State?
    end
    class Battle
      # One writer; both construction sites (Scene::Map#drive_battle) pass the Scene::Map `self`.
      @map: RPG2k::Scene::Map?
    end
    # One writer each, in #initialize; the only construction sites are in Scene::Map#initialize:
    # `MapWorld.new(self, @rng)` / `VehicleWorld.new(self, @rng, type)`, Scene::Map's one @rng writer being
    # `Game::Rng.new(0x2000)`.
    class MapWorld
      @scene: RPG2k::Scene::Map?
      @rng: Game::Rng?
    end
    class VehicleWorld
      @scene: RPG2k::Scene::Map?
      @rng: Game::Rng?
    end
  end
end

# ---- receiver_returns.rbs
# Types that prove the receiver of a block send. Each was
# checked against every return path / every writer in mruby-rpg2k/mrblib; parameters are left untyped where the
# method's own required count is all the declaration needs.
class RPG2k
  module Scene
    class Map
      # `@event_tiles_by_pos[[x, y]] || NO_BLOCKERS`: @event_tiles_by_pos is only ever `{}` (three writers),
      # its values only come from `(@event_tiles_by_pos[[x, y]] ||= []) << e` (#index_event_tile; the other
      # access deletes), and NO_BLOCKERS is `[].freeze`. Never nil. Element left untyped.
      # Runtime-checked: a Hash read joined with `||`.
      %a{bc2cpp:hint}
      def blockers_at: (untyped x, untyped y) -> Array
      # The one writer is `@common = Game::CommonEvent.load(@db)` (#initialize's transition block), whose return
      # paths are `list` (only CommonEventRecord.new pushed), `list` early when there is no table, and `[]` in
      # its rescue.
      @common: Array[Game::CommonEvent::CommonEventRecord]
    end
    class EquipMenu
      # `return @candidates if @candidates` (the only non-nil writer is the line below), else
      # `@candidates = real + [[0, 0]]`, an Array#+ result. Never nil.
      # Runtime-checked: the cached `@candidates` read.
      %a{bc2cpp:hint}
      def candidates: () -> Array
    end
  end
end
# ---- record_types.rbs
# Record types: checked at every write of the ivar name in the closed world, so a
# wrong field is a TC1009 build error at the offending write, never a silent hint.
module RPG2k
  module Scene
    class Battle
      # Writers (both scene classes; RPG2k3::Scene::Battle reuses the ivar): `@ui = {}` in #initialize, so every key
      # is optional; `@ui.update({...})` in #start, the only writer of :battle (Game::Battle.new), :troop
      # (`troop = Game::Troop.new(...)`), :events (Game::Interpreter.new), :allies/:foes (block `map`s) and
      # :pages_run (`{}`, also reset by `@ui[:pages_run] = {}`); `@ui[:enemy_sprites]`/`[:actor_sprites]` are nil or
      # `Array.new(n) { }`. The other keys hold method results or arithmetic the checker cannot trace: untyped.
      @ui: { ?battle: Game::Battle, ?troop: Game::Troop, ?events: Game::Interpreter, ?allies: untyped,
             ?foes: untyped, ?pages_run: Hash[untyped, untyped], ?enemy_sprites: Array[untyped]?,
             ?actor_sprites: Array[untyped]?,
             ?phase: untyped, ?options_shown: untyped, ?opt: untyped, ?actor_i: untyped, ?cmd: untyped,
             ?target_i: untyped, ?skill_i: untyped, ?item_i: untyped, ?ally_i: untyped, ?pending: untyped,
             ?skills: untyped, ?items: untyped, ?status_win: untyped, ?cmd_win: untyped, ?target_win: untyped,
             ?skill_win: untyped, ?item_win: untyped, ?ally_win: untyped, ?action_win: untyped,
             ?anim_timer: untyped, ?back_sprite: untyped, ?result_win: untyped, ?result: untyped,
             ?event_win: untyped, ?battler_boundary: untyped, ?event_return_phase: untyped, ?frame: untyped,
             ?banner_reveal: untyped, ?banner_shown: untyped, ?banner_timer: untyped, ?banner_pending: untyped,
             ?sprite_names: untyped, ?sprite_hues: untyped, ?event_timer: untyped, ?desc_win: untyped,
             ?list_up_arrow: untyped, ?list_down_arrow: untyped, ?list_up_shown: untyped,
             ?list_down_shown: untyped, ?list_arrow_anim: untyped, ?enemy_shake: untyped, ?skill_top: untyped,
             ?item_top: untyped }
    end

    class Map
      # The Enter Hero Name widget (scene/map.rb #drive_name_input .. #close_name_input). Writers: the two literals
      # in #drive_name_input (ASCII grid: :win nil; kana grid: :page, no :win), `= nil` in #initialize and
      # #close_name_input, and key stores in the handlers and in #draw_kana_face / #draw_kana_name_field /
      # #draw_kana_grid, which receive the Hash as `ui` (the interprocedural scan follows it). `@name_ui.nil?` gates
      # #drive_parallel_wait. Only :kana is a literal everywhere it is written; the rest hold method results,
      # arithmetic or window objects and stay untyped (no receiver hint: nothing this record names is forced).
      @name_ui: { name: untyped, sel: untyped, kana: bool, actor_id: untyped, background: untyped,
                  interp: untyped, ?win: untyped, ?page: untyped, ?face_win: untyped, ?name_win: untyped,
                  ?grid_win: untyped }?
    end
  end
end

