# ---- nilable_ivars.rbs
# Ivars that #initialize stores from a parameter (ADR 0456). The parameter types used to be the hints; they are now
# checked call-site facts, and no caller of a POLY `initialize` can be proven, so the stores are declared here as
# `T?` ("T or nil", the contract every ClassLayout fact already has). Each was checked against every writer and every
# construction site in the closed world (mruby-rpg2k/mrblib), as noted.
#
# @state: the only writer in each class is `@state = state` in #initialize. Every construction site passes nil, an
# `@state` of another class below (or Scene::Battle's `map.state`, Scene::Map's attr_reader) or RPG2k's own `state`:
# `Game::State.new(...)` (#start_new_game, through RGSS::Profiler.section, which returns its block's value),
# `load_save_state` (Game::State.from_lsd, whose one return is `new(party, ...)`, or nil) or that same local.
module Game
  class Interpreter
    @state: Game::State?
  end
  class EnemyAi
    # Constructed only by Scene::Battle: `Game::EnemyAi.new(db, @state)`, db being Scene::Base#db.
    @state: Game::State?
    @db: LCF::Database?
  end
  # @db: each class's one writer is `@db = db` in #initialize. Party.new gets RPG2k#db (main.rb, whose one writer
  # is `LCF::Database.new`) or Game::State.from_lsd's db (RPG2k#load_save_state passes @db); Actors.new only
  # Party's db; Actor.new only Actors' @db; Shop.new and EnemyAi.new Scene::Base#db.
  class Actor
    @db: LCF::Database?
  end
  class Actors
    @db: LCF::Database?
  end
  class Party
    @db: LCF::Database?
  end
  class Shop
    @db: LCF::Database?
    # The one construction site (Scene::Map#open_shop) passes `@state.party`, Game::State's attr_reader.
    @party: Game::Party?
    # Every return is provably bool (predicate gate: tools/bc2cpp/predicate_returns.rb).
    def sellable?: (untyped) -> bool
  end
  class State
    # One writer (#initialize). Constructed by RPG2k#start_new_game with `Game::Party.new(@db)` and by
    # State.from_lsd with `Party.new(db, member_ids)`.
    @party: Game::Party?
  end
  class Map
    # One writer (#initialize); one construction site: RPG2k#load_map's `LCF::MapUnit.new(...)`.
    @unit: LCF::MapUnit?
  end
end
class RPG2k
  module Scene
    class Base
      # One writer each, in #initialize(parent). Every scene is built with RPG2k's `self` (main.rb), another scene's
      # @parent / `parent` (Scene::Base's attr_reader) or `map.parent` (Scene::Battle). RPG2k#db / #map_tree are
      # attr_readers whose one writers are `LCF::Database.new` / `LCF::MapTree.new`.
      @parent: RPG2k?
      @db: LCF::Database?
      @map_tree: LCF::MapTree?
    end
    class Map
      @state: Game::State?
    end
    class Menu
      @state: Game::State?
    end
    class SaveLoad
      @state: Game::State?
    end
    class MapViewer
      @state: Game::State?
    end
    class StatusMenu
      @state: Game::State?
    end
    class SkillMenu
      @state: Game::State?
    end
    class DebugMenu
      @state: Game::State?
    end
    class ItemMenu
      @state: Game::State?
    end
    class Order
      @state: Game::State?
    end
    class EquipMenu
      @state: Game::State?
    end
    class ChipsetEditor
      @state: Game::State?
    end
    class Battle
      # One writer; both construction sites (Scene::Map#drive_battle) pass the Scene::Map `self`.
      @map: RPG2k::Scene::Map?
    end
    # One writer each, in #initialize; the only construction sites are in Scene::Map#initialize:
    # `MapWorld.new(self, @rng)` / `VehicleWorld.new(self, @rng, type)`, Scene::Map's one @rng writer being
