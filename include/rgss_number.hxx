// RGSS numbers at the mruby boundary. A Float build passes Float values. A
// no-Float build (MRB_NO_FLOAT) has no Float, so the same values are Integers:
// zoom, angle and colour components are whole numbers there (num_value rounds),
// and a transition fraction is an Integer in 1/1024 units (mrblib/lib.rb's
// FLOAT-BEGIN block, generated by mruby-rgss/gen_rgss_nofloat.rb). The C++ math
// is double on both builds.
#pragma once

#include <mruby.h>
#include <mruby/string.h>

#include <cmath>
#include <cstring>

namespace rgss {

inline double num_arg(mrb_state* M, mrb_value v) {
#ifdef MRB_NO_FLOAT
  return static_cast<double>(mrb_as_int(M, v));
#else
  return mrb_as_float(M, v);
#endif
}

inline mrb_value num_value(mrb_state* M, double v) {
#ifdef MRB_NO_FLOAT
  return mrb_fixnum_value(static_cast<mrb_int>(std::lround(v)));
#else
  return mrb_float_value(M, v);
#endif
}

inline bool num_p(mrb_value v) {
#ifdef MRB_NO_FLOAT
  return mrb_fixnum_p(v);
#else
  return mrb_float_p(v);
#endif
}

// A transition progress or softness, 0..1 as a double.
inline double fraction_arg(mrb_state* M, mrb_value v) {
#ifdef MRB_NO_FLOAT
  return static_cast<double>(mrb_as_int(M, v)) / 1024.0;
#else
  return mrb_as_float(M, v);
#endif
}

// A cache key is an exact integer-valued double up to about 2^40, which a
// 32-bit Integer cannot hold: a String of its bytes on a no-Float build.
inline mrb_value key_value(mrb_state* M, double key) {
#ifdef MRB_NO_FLOAT
  return mrb_str_new(M, reinterpret_cast<const char*>(&key), sizeof key);
#else
  return mrb_float_value(M, key);
#endif
}

inline bool key_is(mrb_state* M, mrb_value prev, double key) {
#ifdef MRB_NO_FLOAT
  return mrb_string_p(prev) && RSTRING_LEN(prev) == sizeof key &&
         std::memcmp(RSTRING_PTR(prev), &key, sizeof key) == 0;
#else
  return mrb_float_p(prev) && mrb_float(prev) == key;
#endif
}

}  // namespace rgss
