+/* Fire s->output[pin] for every bit that differs between old_val and
+ * new_val, pin = base_pin + bit index -- shared by the OUT and OUT1
+ * register groups below. */
+static void esp32_gpio_update_outputs(Esp32GpioState *s, int base_pin,
+                                       uint32_t old_val, uint32_t new_val)
+{
+    uint32_t changed = old_val ^ new_val;
+    while (changed) {
+        int bit = ctz32(changed);
+        int pin = base_pin + bit;
+        if (pin < ESP32_GPIO_PIN_COUNT) {
+            qemu_set_irq(s->output[pin], (new_val >> bit) & 1);
+        }
+        changed &= ~(1u << bit);
+    }
+}
+
 static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 {
     Esp32GpioState *s = ESP32_GPIO(opaque);
     uint64_t r = 0;
     switch (addr) {
+    case A_GPIO_OUT:
+        r = s->out_reg;
+        break;
+    case A_GPIO_OUT1:
+        r = s->out1_reg;
+        break;
     case A_GPIO_STRAP:
         r = s->strap_mode;
         break;
@@ -39,6 +63,43 @@ static uint64_t esp32_gpio_read(void *opaque, hwaddr addr, unsigned int size)
 static void esp32_gpio_write(void *opaque, hwaddr addr,
                        uint64_t value, unsigned int size)
 {
+    Esp32GpioState *s = ESP32_GPIO(opaque);
+    uint32_t new_val;
+    switch (addr) {
+    case A_GPIO_OUT:
+        new_val = value;
+        esp32_gpio_update_outputs(s, 0, s->out_reg, new_val);
+        s->out_reg = new_val;
+        break;
+    case A_GPIO_OUT_W1TS:
+        new_val = s->out_reg | value;
+        esp32_gpio_update_outputs(s, 0, s->out_reg, new_val);
+        s->out_reg = new_val;
+        break;
+    case A_GPIO_OUT_W1TC:
+        new_val = s->out_reg & ~value;
+        esp32_gpio_update_outputs(s, 0, s->out_reg, new_val);
+        s->out_reg = new_val;
+        break;
+    case A_GPIO_OUT1:
+        new_val = value;
+        esp32_gpio_update_outputs(s, 32, s->out1_reg, new_val);
+        s->out1_reg = new_val;
+        break;
+    case A_GPIO_OUT1_W1TS:
+        new_val = s->out1_reg | value;
+        esp32_gpio_update_outputs(s, 32, s->out1_reg, new_val);
+        s->out1_reg = new_val;
+        break;
+    case A_GPIO_OUT1_W1TC:
+        new_val = s->out1_reg & ~value;
+        esp32_gpio_update_outputs(s, 32, s->out1_reg, new_val);
+        s->out1_reg = new_val;
+        break;
+
+    default:
+        break;
+    }
 }
 
