# Maix Amigo Renode boot (docs: app/maix/README.md "Emulation").
#
# Boots a Maix Amigo firmware ELF under stock Renode far enough to prove
# the CPU actually runs -- reaches its own setup()/loop() symbols; the
# mruby-linking firmware additionally prints its interpreter markers over
# the emulated UARTHS -- rather than checking it only compiles, which is
# all the `maix` CI job does.
#
# Usage: pass -e "set elf_path @/path/to/firmware.elf" before including this,
# plus repl_path (@/path/to/amigo.repl -- scripts/maix_renode_boot.bash
# generates it from amigo.repl.template with the model paths filled in, since
# a .repl cannot take variables) and setup_addr/loop_addr -- that ELF's own
# setup/loop symbol addresses (riscv64-unknown-elf-nm firmware.elf, grep -w
# setup and loop). scripts/maix_renode_boot.bash wraps all of this.
#
# What the template models for real: dual RV64 cores, SiFive UARTHS (the
# firmware's Serial), CLINT, PLIC -- stock Renode's own kendryte_k210
# description, unchanged. Everything else is Tags below, except:
#
# - fpioa (a Python stub): fpioa_get_io_by_function scans io[].ch_sel and
#   asserts when nothing is routed; a plain Tag (reads zero) hangs Arduino
#   pinMode on its first call. The stub remembers routed functions so the
#   scan finds them (see fpioa.py).
# - gpio (a Python stub): gpio_set_pin asserts dir == 1, but Tags drop the
#   direction write gpio_set_drive_mode just made. Same remember-and-answer
#   shape (see gpio.py).
# - dmac (a Python stub): remembers SAR/DAR/BLOCK_TS/CTL per channel, which
#   a plain Tag cannot do (the values must still be there when the transfer
#   runs). The transfer itself runs in dma_hook.py's hook below.
# - spi0 (a Python stub): answers the LCD driver's status poll with a
#   constant 0x06 (TX FIFO not full, not busy). The capture does not live
#   here (see dma_hook.py).
#
# Info-level logging is load-bearing, not noise: the UARTHS analyzer's own
# "[INFO] uart:" lines are how the hello/heartbeat markers surface, so unlike
# app/wio/renode/boot.resc this script must NOT set logLevel 3 (that quiets
# the analyzer into showing nothing at all -- confirmed the confusing way).

mach create "maix_amigo"
machine LoadPlatformDescription $repl_path
sysbus LoadELF $elf_path

# Clock tree: not modeled; ignore writes, fake PLL lock like stock Renode's
# own kendryte_k210 demo does (pll_lock reads all-ones, so sysctl_pll_is_lock
# and sysctl_pll_clear_slip both pass immediately).
sysbus Tag <0x50440000 0x10000> "SYSCTL"
sysbus Tag <0x50440018 0x4> "pll_lock" 0xFFFFFFFF

# GPIO/FPIOA/SPI/DMA/GPIOHS: the fpioa/gpio/dmac/spi0 Python models (see
# their own file comments) shadow these Tags where they overlap; the Tags
# cover the rest.
sysbus Tag <0x50201000 0xAF000> "APB0"
sysbus Tag <0x502C0000 0x40000> "APB0HI"
sysbus Tag <0x38001000 0x1000> "GPIOHS"
sysbus Tag <0x52001000 0xFF000> "SPIHI"
sysbus Tag <0x50001000 0xFF000> "DMACHI"

# Each hook removes itself (cpu.PC is its own trigger address, since a hook
# fires before the instruction there executes) after firing once: loop() in
# particular gets called on every pass through the firmware's main loop, so
# a hook that just kept printing would flood the log.
cpu1 AddHook $setup_addr "print(\"=== REACHED setup() ===\"); cpu.RemoveHooksAt(cpu.PC)"
cpu1 AddHook $loop_addr "print(\"=== REACHED loop() ===\"); cpu.RemoveHooksAt(cpu.PC)"

# The DMA copy engine lives in dma_hook.py: a hook registered with the
# function object (not by name -- hook strings run in a scope that cannot
# see `include`d files' globals, confirmed the confusing way), which carries
# its own globals along. See that file's own comment for what the hook may
# and may not do. $dma_hook_path is generated by
# scripts/maix_renode_boot.bash from dma_hook.py.template with the
# channel-enable address filled in, the same way $repl_path is.
include $dma_hook_path

showAnalyzer uart

$duration?="00:00:05"
emulation RunFor $duration
echo "PC after that much virtual time:"
cpu1 PC
